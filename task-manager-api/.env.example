# Copy to .env and fill in. Never commit the .env file.

# Flask
SECRET_KEY=
DATABASE_URL=sqlite:///tasks.db
HOST=0.0.0.0
PORT=5000
DEBUG=false
LOG_LEVEL=INFO

# Token required in the X-Admin-Token header by the administrative user operations
ADMIN_TOKEN=

# SMTP account used by services/notification_service.py
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Passwords of the users created by seed.py (a random one is generated when empty)
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_MANAGER_PASSWORD=
