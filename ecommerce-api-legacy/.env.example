# Copy this file to .env and fill in the values. Never commit the .env file.

# HTTP port (default: 3000)
PORT=
# SQLite database path (default: :memory:)
DATABASE_PATH=
# Log level: debug, info, warn or error (default: info)
LOG_LEVEL=
# Token required in the x-admin-token header by the admin routes.
# While it is empty, the admin routes answer 403.
ADMIN_TOKEN=
# Key of the payment gateway
PAYMENT_GATEWAY_KEY=
# Password of the user created by the seed. While it is empty, a random one is used.
SEED_USER_PASSWORD=
