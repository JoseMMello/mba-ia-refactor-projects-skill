# Copy to .env and export the variables before starting the application:
#   set -a; source .env; set +a; python app.py

SECRET_KEY=
DATABASE_PATH=loja.db
HOST=0.0.0.0
PORT=5001
DEBUG=false
LOG_LEVEL=INFO
APP_ENV=producao

# Required in the X-Admin-Token header by POST /admin/reset-db.
# Leave empty to keep the admin routes disabled.
ADMIN_TOKEN=

# Passwords for the sample users created when a new database is seeded.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
